<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wig3003.photoapp.ui.MainController"
            styleClass="root-pane">

    <fx:define>
        <ToggleGroup fx:id="filterGroup"/>
    </fx:define>

    <!-- ═══════════════════════════════════════════════════════
         LEFT SIDEBAR
         ═══════════════════════════════════════════════════════ -->
    <left>
        <VBox styleClass="sidebar">

            <!-- Brand -->
            <HBox styleClass="brand-row">
                <StackPane styleClass="brand-icon-box">
                    <Label text="V" styleClass="brand-icon"/>
                </StackPane>
                <Label text="Vi-Flow" styleClass="brand-name"/>
            </HBox>

            <!-- LIBRARY section -->
            <Label text="LIBRARY" styleClass="nav-section-label"/>

            <HBox fx:id="navLibrary" styleClass="nav-item"
                  alignment="CENTER_LEFT" spacing="12"
                  onMouseClicked="#handleNavLibrary">
                <VBox.margin><Insets top="2" right="8" bottom="2" left="8"/></VBox.margin>
                <FontIcon iconLiteral="bi-columns" iconSize="16" styleClass="nav-icon-label"/>
                <Label text="Library" styleClass="nav-label">
                    <HBox.hgrow>ALWAYS</HBox.hgrow>
                </Label>
                <Label fx:id="countLibrary" text="0" styleClass="nav-count"/>
            </HBox>

            <HBox fx:id="navFavorites" styleClass="nav-item"
                  alignment="CENTER_LEFT" spacing="12"
                  onMouseClicked="#handleNavFavorites">
                <VBox.margin><Insets top="2" right="8" bottom="2" left="8"/></VBox.margin>
                <FontIcon iconLiteral="bi-heart" iconSize="16" styleClass="nav-icon-label"/>
                <Label text="Favorites" styleClass="nav-label">
                    <HBox.hgrow>ALWAYS</HBox.hgrow>
                </Label>
                <Label fx:id="countFavorites" text="0" styleClass="nav-count"/>
            </HBox>

            <HBox fx:id="navAnnotated" styleClass="nav-item"
                  alignment="CENTER_LEFT" spacing="12"
                  onMouseClicked="#handleNavAnnotated">
                <VBox.margin><Insets top="2" right="8" bottom="2" left="8"/></VBox.margin>
                <FontIcon iconLiteral="bi-pencil-square" iconSize="16" styleClass="nav-icon-label"/>
                <Label text="Annotated" styleClass="nav-label">
                    <HBox.hgrow>ALWAYS</HBox.hgrow>
                </Label>
                <Label fx:id="countAnnotated" text="0" styleClass="nav-count"/>
            </HBox>

            <!-- STUDIO section -->
            <Label text="STUDIO" styleClass="nav-section-label"/>

            <HBox fx:id="navEdit" styleClass="nav-item" onMouseClicked="#handleNavEdit">
                <VBox.margin><Insets top="2" right="8" bottom="2" left="8"/></VBox.margin>
                <FontIcon iconLiteral="bi-circle-square" iconSize="16" styleClass="nav-icon-label"/>
                <Label text="Edit" styleClass="nav-label">
                    <HBox.hgrow>ALWAYS</HBox.hgrow>
                </Label>
            </HBox>

            <HBox fx:id="navMosaic" styleClass="nav-item" onMouseClicked="#handleNavMosaic">
                <VBox.margin><Insets top="2" right="8" bottom="2" left="8"/></VBox.margin>
                <FontIcon iconLiteral="bi-grid" iconSize="16" styleClass="nav-icon-label"/>
                <Label text="Mosaic" styleClass="nav-label">
                    <HBox.hgrow>ALWAYS</HBox.hgrow>
                </Label>
            </HBox>

            <HBox fx:id="navVideo" styleClass="nav-item" onMouseClicked="#handleNavVideo">
                <VBox.margin><Insets top="2" right="8" bottom="2" left="8"/></VBox.margin>
                <FontIcon iconLiteral="bi-camera-video" iconSize="16" styleClass="nav-icon-label"/>
                <Label text="Video" styleClass="nav-label">
                    <HBox.hgrow>ALWAYS</HBox.hgrow>
                </Label>
            </HBox>

            <HBox fx:id="navShare" styleClass="nav-item" onMouseClicked="#handleNavShare">
                <VBox.margin><Insets top="2" right="8" bottom="2" left="8"/></VBox.margin>
                <FontIcon iconLiteral="bi-share" iconSize="16" styleClass="nav-icon-label"/>
                <Label text="Share" styleClass="nav-label">
                    <HBox.hgrow>ALWAYS</HBox.hgrow>
                </Label>
            </HBox>

        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════════════════
         CENTER — Library view  ↔  Detail view
         ═══════════════════════════════════════════════════════ -->
    <center>
        <StackPane>

            <!-- ─── LIBRARY VIEW ─────────────────────────────── -->
            <VBox fx:id="libraryView" styleClass="content-area">

                <!-- Header bar -->
                <HBox styleClass="content-header">
                    <Label text="Your Library" styleClass="page-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="importBtn" text="Import" styleClass="btn-secondary">
                        <graphic>
                            <FontIcon iconLiteral="bi-box-arrow-in-down" iconSize="16"/>
                        </graphic>
                    </Button>
                </HBox>

                <!-- Filter pills -->
                <HBox styleClass="filter-bar">
                    <ToggleButton fx:id="filterAll" text="All · 0"
                                  styleClass="filter-pill"
                                  selected="true"
                                  toggleGroup="$filterGroup"
                                  onAction="#handleFilter"/>
                    <ToggleButton fx:id="filterAnnotated" text="Annotated · 0"
                                  styleClass="filter-pill"
                                  toggleGroup="$filterGroup"
                                  onAction="#handleFilter"/>
                    <ToggleButton fx:id="filterFavorites" text="Favorites · 0"
                                  styleClass="filter-pill"
                                  toggleGroup="$filterGroup"
                                  onAction="#handleFilter"/>
                    <ToggleButton fx:id="filterRecent" text="Recent"
                                  styleClass="filter-pill"
                                  toggleGroup="$filterGroup"
                                  onAction="#handleFilter"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="selectedCountLabel" text=""
                           styleClass="selected-count-label"/>
                </HBox>

                <!-- Grid / Empty state -->
                <StackPane VBox.vgrow="ALWAYS">

                    <!-- Thumbnail grid (hidden until images load) -->
                    <ScrollPane fx:id="gridScrollPane"
                                styleClass="grid-scroll-pane"
                                fitToWidth="true"
                                visible="false" managed="false">
                        <TilePane fx:id="photoGrid"
                                  styleClass="photo-grid"
                                  prefColumns="5"
                                  hgap="8" vgap="8"/>
                    </ScrollPane>

                    <!-- Empty state -->
                    <VBox fx:id="emptyState" styleClass="empty-state"
                          alignment="CENTER" spacing="12">
                        <StackPane styleClass="empty-icon-bg" alignment="CENTER">
                            <FontIcon iconLiteral="bi-images" iconSize="48" styleClass="empty-icon"/>
                        </StackPane>
                        <Label text="No photos yet." styleClass="empty-title"/>
                        <Label styleClass="empty-body" textAlignment="CENTER"
                               text="Drop a folder anywhere on this window, or use&#10;import to point Vi-Flow at your photo library"
                               wrapText="true"/>
                        <HBox styleClass="empty-buttons">
                            <Button text="Browse files" styleClass="btn-secondary"
                                    onAction="#handleImport">
                                <graphic>
                                    <FontIcon iconLiteral="bi-folder" iconSize="16"/>
                                </graphic>
                            </Button>
                            <Button text="Import folder" styleClass="btn-primary"
                                    onAction="#handleImportFolder">
                                <graphic>
                                    <FontIcon iconLiteral="bi-box-arrow-in-down" iconSize="16" iconColor="WHITE" />
                                </graphic>
                            </Button>
                        </HBox>
                    </VBox>

                    <!-- Filtered empty state (Favorites / Annotated) -->
                    <VBox fx:id="emptyStateFiltered" styleClass="empty-state"
                          alignment="CENTER" spacing="12"
                          visible="false" managed="false">
                        <StackPane styleClass="empty-icon-bg" alignment="CENTER">
                            <FontIcon fx:id="emptyFilteredIcon" iconLiteral="bi-heart"
                                      iconSize="48" styleClass="empty-icon"/>
                        </StackPane>
                        <Label fx:id="emptyFilteredTitle" text=""
                               styleClass="empty-title"/>
                        <Label fx:id="emptyFilteredBody" text=""
                               styleClass="empty-body" wrapText="true"
                               textAlignment="CENTER"/>
                    </VBox>

                </StackPane>
            </VBox>

            <!-- ─── DETAIL VIEW ───────────────────────────────── -->
            <VBox fx:id="detailView" styleClass="detail-view"
                  visible="false" managed="false"
                  VBox.vgrow="ALWAYS">

                <!-- Detail header -->
                <HBox styleClass="detail-header">
                    <Label fx:id="detailFilename" text=""
                           styleClass="detail-filename"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="detailDimensions" text=""
                           styleClass="detail-dimensions"/>
                    <Button fx:id="heartButton" styleClass="heart-btn"
                            onAction="#handleToggleFavourite">
                    </Button>
                    <Button text="Share" styleClass="btn-secondary"
                            onAction="#handleShare"/>
                </HBox>

                <!-- Full-res image area -->
                <StackPane fx:id="detailImageArea"
                        styleClass="detail-image-area"
                        VBox.vgrow="ALWAYS"
                        minHeight="300"
                        maxHeight="600">
                    <ImageView fx:id="detailImageView"
                            preserveRatio="true" smooth="true"
                            pickOnBounds="true"/>
                </StackPane>

            </VBox>

            <!-- ─── MOSAIC VIEW ───────────────────────────── -->
            <fx:include fx:id="mosaicView"
                        source="MosaicView.fxml"
                        visible="false" managed="false"/>

            <!-- ─── VIDEO VIEW ───────────────────────────── -->
            <fx:include fx:id="videoView"
                        source="VideoView.fxml"
                        visible="false" managed="false"/>

            <!-- ─── SHARE VIEW ──────────────────────────── -->
            <fx:include fx:id="shareView"
                        source="ShareView.fxml"
                        visible="false" managed="false"/>

            <!-- ─── ANNOTATION SIDE PANEL ──────────────── -->
            <VBox fx:id="annotationPanel"
                  visible="false" managed="false"
                  prefWidth="300" maxWidth="300"
                  spacing="0"
                  StackPane.alignment="CENTER_RIGHT"
                  style="-fx-background-color:#FBF8F3; -fx-border-color:#ECE4D3; -fx-border-width:0 0 0 1; -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.10),12,0,-4,0);">

                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-padding:14 16 14 16; -fx-border-color:transparent transparent #ECE4D3 transparent; -fx-border-width:0 0 1 0;">
                    <VBox HBox.hgrow="ALWAYS" spacing="3">
                        <Label fx:id="panelFilename" text=""
                               style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#1F1B16;"/>
                        <Label text="Annotated photos show &#9829; in the upper-right of the preview"
                               wrapText="true"
                               style="-fx-font-size:10px; -fx-text-fill:#9C907D;"
                               maxWidth="220"/>
                    </VBox>
                    <Button text="&#x2715;" onAction="#handleCloseAnnotationPanel"
                            style="-fx-background-color:transparent; -fx-border-color:transparent; -fx-text-fill:#9C907D; -fx-font-size:14px; -fx-cursor:hand; -fx-padding:4 8;"/>
                </HBox>

                <!-- Existing annotation (shown when one exists) -->
                <VBox fx:id="existingAnnotationBox"
                      visible="false" managed="false"
                      spacing="6"
                      style="-fx-padding:12 16 12 16; -fx-border-color:transparent transparent #ECE4D3 transparent; -fx-border-width:0 0 1 0;">
                    <Label text="NOTE"
                           style="-fx-font-size:10px; -fx-font-weight:bold; -fx-text-fill:#9C907D;"/>
                    <Label fx:id="existingAnnotationText" text=""
                           wrapText="true"
                           style="-fx-font-size:13px; -fx-font-style:italic; -fx-text-fill:#1F1B16; -fx-background-color:white; -fx-border-color:#ECE4D3; -fx-border-radius:8; -fx-background-radius:8; -fx-padding:10 12;"/>
                    <Label fx:id="existingAnnotationDate" text=""
                           style="-fx-font-size:10px; -fx-text-fill:#9C907D;"/>
                    <HBox spacing="8" style="-fx-padding:4 0 0 0;">
                        <Button text="Edit" onAction="#handleEditAnnotation"
                                styleClass="btn-secondary"
                                prefHeight="28"
                                style="-fx-font-size:11px;"/>
                        <Button text="Delete" onAction="#handleDeleteAnnotation"
                                prefHeight="28"
                                style="-fx-font-size:11px; -fx-background-color:transparent; -fx-text-fill:#B0432B; -fx-border-color:#F5C0C0; -fx-border-radius:8; -fx-background-radius:8; -fx-padding:4 12; -fx-cursor:hand;"/>
                    </HBox>
                </VBox>

                <!-- Add / edit note -->
                <VBox fx:id="addNoteBox"
                      spacing="8"
                      VBox.vgrow="ALWAYS"
                      style="-fx-padding:12 16 12 16;">
                    <Label fx:id="addNoteLabel" text="Add a note"
                           style="-fx-font-size:10px; -fx-font-weight:bold; -fx-text-fill:#9C907D;"/>
                    <TextArea fx:id="annotationTextArea"
                              promptText="A note about this image…"
                              wrapText="true"
                              prefHeight="120"
                              styleClass="annotation-field"/>
                    <HBox alignment="CENTER_RIGHT" style="-fx-padding:4 0 0 0;">
                        <Label fx:id="annotationFeedbackLabel" text=""
                               style="-fx-font-size:11px; -fx-font-style:italic; -fx-text-fill:#6B6051;">
                            <HBox.hgrow>ALWAYS</HBox.hgrow>
                        </Label>
                        <Button fx:id="annotationSaveBtn" text="Add"
                                onAction="#handleSaveAnnotation"
                                styleClass="btn-primary"
                                style="-fx-font-size:12px; -fx-padding:6 18;"/>
                    </HBox>
                </VBox>

            </VBox>

        </StackPane>
    </center>

</BorderPane>
